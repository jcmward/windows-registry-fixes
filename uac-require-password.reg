Windows Registry Editor Version 5.00

; Require Administrator password for UAC elevation prompts
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"ConsentPromptBehaviorAdmin"=dword:00000002
"ConsentPromptBehaviorUser"=dword:00000002
; Values:
; 0 = No prompt (dangerous!)
; 1 = Require admin password on secure desktop
; 2 = Consent prompt on secure desktop
; 3 = Require admin password
; 4 = Consent prompt
; 5 = Consent prompt for non-Windows apps (default)
